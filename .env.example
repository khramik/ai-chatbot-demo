# Copy this file to .env and fill in the values. Never commit .env.

# AI key from https://console.anthropic.com (leave empty to run in demo mode)
ANTHROPIC_API_KEY=

# Which Claude model answers the chat, and how hard it thinks (low | medium | high)
MODEL=claude-opus-5-5
EFFORT=low

# Optional: send every new lead to an automation (n8n / Make / Zapier webhook URL)
LEAD_WEBHOOK_URL=
# Shared secret sent as the x-webhook-secret header (must match the automation)
LEAD_WEBHOOK_SECRET=

# Websites allowed to embed the widget, comma-separated (e.g. https://client-site.com)
ALLOWED_ORIGINS=

# Max chat messages per visitor per minute
RATE_LIMIT_PER_MINUTE=20

PORT=3000
